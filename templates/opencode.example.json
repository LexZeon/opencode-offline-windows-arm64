{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["local"],
  "model": "local/{env:OPENCODE_LOCAL_MODEL}",
  "small_model": "local/{env:OPENCODE_LOCAL_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "plugin": [],
  "lsp": false,
  "formatter": false,
  "snapshot": false,
  "provider": {
    "local": {
      "name": "Local model (configure your own backend)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {"baseURL": "{env:OPENCODE_LOCAL_BASE_URL}"},
      "models": {
        "{env:OPENCODE_LOCAL_MODEL}": {
          "name": "local-model",
          "tool_call": true,
          "limit": {"context": 8192, "output": 2048}
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "mcp": {},
  "experimental": {"openTelemetry": false}
}
